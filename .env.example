# thedigitalwit environment variables
# Copy this file to `.env.local` (for your computer) and fill in the values.
# In production, add the same names in your host's dashboard (e.g. Vercel ->
# Project -> Settings -> Environment Variables). Never commit real values.

# --- Supabase (login + "My saved items") ------------------------------------
# Supabase dashboard -> your project -> Project Settings -> API (or "API Keys").
# Until these are filled in, the site works normally and the login page shows
# "Sign-in isn't switched on yet".
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (starts with sb_publishable_). Older projects call it
# the "anon public" key; either works. It is safe in the browser because the
# database is protected by row-level security (supabase/migrations/0001_saved_items.sql).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Google and Microsoft client IDs/secrets are NOT set here. They are entered in
# the Supabase dashboard (Authentication -> Sign In / Providers). See
# AUTH_SETUP.md for step-by-step instructions.

# --- Site address ------------------------------------------------------------
# Your public address, with no trailing slash. Used for link previews, the
# sitemap and robots.txt. On Vercel this can be left out until you add a custom
# domain; Vercel's own address is used automatically.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# --- AI: "Describe your case" boxes (optional) --------------------------------
# Lets visitors describe their case in plain English on every calculator, the
# GTM Generator, Media Plan Generator, Media Mix Model and
# DoohSight; Claude reads the text and fills in the fields. Get a key at
# console.anthropic.com -> API Keys. You pay Anthropic per request (about one to
# three US cents each with the default model). Until a key is set, a free
# built-in reader in the visitor's browser fills what it can instead.
# Server-only: never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional. Defaults to claude-opus-5-5. claude-haiku-5-5 costs far less per
# request but understands loosely worded descriptions less well.
# ANTHROPIC_MODEL=claude-opus-5-5
